# Copy this file to .env and fill in your key.
# If GEMINI_API_KEY is empty the app runs in deterministic MOCK mode (no internet needed).
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Where run state is checkpointed (SQLite file).
DB_PATH=data/agent.db

# Agent guard rails
MAX_STEPS=15
MAX_RUN_TOKENS=200000
# Small pause between steps so a human can watch the agent think in the UI (0 = full speed)
STEP_DELAY_SECONDS=0.8
# Pause between streamed text chunks (plan, thinking, answer) in the UI (0 = no pacing)
STREAM_DELAY_SECONDS=0.03
# Tool retry policy
TOOL_MAX_RETRIES=3
TOOL_BACKOFF_SECONDS=0.3
# Runs that finish below this confidence are routed to a human (status = escalated)
MIN_CONFIDENCE=0.6

# Pricing used for cost estimates (USD per 1M tokens) - check ai.google.dev/gemini-api/docs/pricing
PRICE_INPUT_PER_M=0.30
PRICE_OUTPUT_PER_M=2.50
